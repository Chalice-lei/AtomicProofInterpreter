# 测试基于计数的for循环（固定次数迭代）
Contract ForLoopBasicCountTest:
    def test_basic_count_loop():
      # 初始化变量
      acc: int = 0

      # 循环3次：i = 0, 1, 2
      for i in Range(3):
         acc = acc + i

      # 循环3次：i = 1, 2, 3
      for i in Range(1, 4):
         acc = acc + i

      # 循环2次：i = 1, 3（步长为2）
      for i in Range(1, 4, 2):
         acc = acc + i