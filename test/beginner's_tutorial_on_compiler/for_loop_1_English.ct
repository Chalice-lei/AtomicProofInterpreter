# Test count-based for loop (fixed number of iterations)
Contract ForLoopBasicCountTest:
    def test_basic_count_loop():
      # Initialize variable
      acc: int = 0

      # Loop 3 times: i = 0, 1, 2
      for i in Range(3):
         acc = acc + i

      # Loop 3 times: i = 1, 2, 3
      for i in Range(1, 4):
         acc = acc + i

      # Loop 2 times: i = 1, 3 (step size 2)
      for i in Range(1, 4, 2):
         acc = acc + i
