# 测试uint64数组类型的复合类型
Contract TestUint64Array:
    def test():
        # 声明包含uint64数组的复合类型
        # uint64[3]表示3个uint64，每个8字节，共24字节
        data = Push(0x2c0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728)
        
        # 复合类型包含hex和uint64数组
        mixed: {values:uint64[3], header:hex20} = data
        
        # 访问字段
        h: hex20 = mixed.header

