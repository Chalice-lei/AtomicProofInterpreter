# Debugger regression: stack trace visualizer should show main/alt movement.
Contract DebugStackVisualizerAlt:
    def test_alt_roundtrip(input: int):
        temp = Push(10)
        temp2 = Push(150)
        temp3 = temp.Clone() + temp2.Clone()
        SetAlt(temp)
        SetMain(temp)
        result: int = temp + input
