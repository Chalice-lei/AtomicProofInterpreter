# 测试多嵌套if语句
Contract BranchNestedIfTest:
    def test_nested_if(score: int):
        category: string

        # 多层嵌套的条件判断
        if score.clone() >= 90:
            category = "excellent"
        else:
            if score.clone() >= 80:
                category = "good"
            else:
                if score.clone() >= 60:
                    category = "pass"
                else:
                    category = "fail"