# 测试嵌套for循环
Contract ForLoopNestedTest:
    def test_nested_loop():
        # 定义数组
        matrix_1: int[2] = [1, 2]
        matrix_2: int[2] = [3, 4]
        matrix_sum: int = 0
        # 外层循环
        for i in range(2):
            # 内层循环
            for j in range(2):
                a = matrix_1[i].clone()
                b = matrix_2[j].clone()
                matrix_sum = matrix_sum + a * b