Contract StructReturnThenVoid:
    Struct Pair:
        left: number
        right: number
    def _identity(data: Pair):
        return data
    def _noop(data: Pair):
        marker = Push(1)
        Delete(marker)
    def main(value: Pair):
        value = _identity(value)
        _noop(value)
        Return(1)
