Contract PrivateAltStructArrayDoubleRestore:
    Struct Input:
        Data: hex36
    def _stash(value: hex36):
        inputData: Input[1]
        inputData[0] = value
        SetAlt(inputData[0])
    def _restore():
        SetMain(inputData[0])
        SetMain(inputData[0])
    def main(value: hex36):
        _stash(value)
        _restore()
        Return(1)
