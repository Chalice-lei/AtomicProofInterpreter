Contract ASTCompoundUnpack:
    def main():
        utxoData: {txid: hex32, vout: hex4, sequence: hex4}
        utxoData = Push(BVM.unlockingInput)

        EqualVerify(utxoData.txid, 0x000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f)
        EqualVerify(utxoData.sequence, 0xffffffff)
        Return(BinToNum(utxoData.vout))
